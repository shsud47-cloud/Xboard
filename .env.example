APP_NAME=XBoard
APP_ENV=production
APP_KEY=base64:PZXk5vTuTinfeEVG5FpYv2l6WEhLsyvGpiWK7IgJJ60=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xboard
DB_USERNAME=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME=null
MAILGUN_DOMAIN=
MAILGUN_SECRET=

# google cloud storage
ENABLE_AUTO_BACKUP_AND_UPDATE=false
GOOGLE_CLOUD_KEY_FILE=config/googleCloudStorageKey.json
GOOGLE_CLOUD_STORAGE_BUCKET=

# Prevent reinstallation
INSTALLED=false

# Passkeys (WebAuthn). Production values for xboard.finn47.xyz.
# The relying party id is the hostname only. Origins must be the full https origin.
# A passkey registered here will not work on any other host.
WEBAUTHN_RP_ID=xboard.finn47.xyz
WEBAUTHN_RP_NAME=XBoard
WEBAUTHN_ORIGIN=https://xboard.finn47.xyz
# Optional comma-separated list. Overrides WEBAUTHN_ORIGIN when set.
# WEBAUTHN_ORIGINS=https://xboard.finn47.xyz
# Challenge lifetime in seconds. Default 300 (5 minutes), same as Dee Panel.
# WEBAUTHN_CHALLENGE_TTL=300